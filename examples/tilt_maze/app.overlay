/*
 * app.overlay — Tilt Maze with GY-521 (MPU-6050) motion control
 *
 * Hardware nodes (VDMA, DC, HDMI framebuffer) are in the shared overlay.
 * This file adds the Zephyr SRAM region and completes the chosen node.
 *
 * SMP atomics (AMO/LR-SC on SiFive U54) require the L2 cache, so Zephyr
 * must run from cached DDR at 0x80000000, not from LIM or scratchpad.
 */

#include <zephyr/dt-bindings/input/input-event-codes.h>
#include "../flappy-microchip/source/dts/overlays/pic64gx_display.overlay"

/ {
	cached_ram: memory@80000000 {
		compatible = "mmio-sram";
		reg = <0x80000000 0x200000>;   /* 2 MB cached DDR */
	};

	chosen {
		zephyr,sram = &cached_ram;
	};

	aliases {
		mikrobus-btn = &mikrobus_btn;
	};

	/* mikroBUS INT push button (10k pull-up to 3P3V, other leg to GND) */
	mikrobus_keys {
		compatible = "gpio-keys";

		mikrobus_btn: mikrobus_btn {
			gpios = <&gpio1 0 GPIO_ACTIVE_LOW>;
			label = "mikroBUS INT button";
			zephyr,code = <INPUT_KEY_2>;
		};
	};
};

&i2c0 {
	status = "okay";
	mpu6050: mpu6050@68 {
		compatible = "invensense,mpu6050";
		reg = <0x68>;
		status = "okay";
		accel-fs = <2>;
		gyro-fs = <250>;
		smplrt-div = <4>;
	};
};
